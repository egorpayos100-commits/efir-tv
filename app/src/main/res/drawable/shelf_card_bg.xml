<?xml version="1.0" encoding="utf-8"?>
<!-- One card on a shelf, and the film posters in the favourites row: a dark plate with a thin edge,
     a white frame once the cursor lands on it, and a blue glowing frame for the channel that is on
     air. Beside the cursor the white frame always wins: that is where he stands. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FF1B2332" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- The glow is two strokes: a wide faint halo, and the bright line just inside it. -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#FF101828" />
                    <stroke android:width="4dp" android:color="#4D4C8DFF" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <solid android:color="@color/rail_tile_bg" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/rail_tile_bg" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
