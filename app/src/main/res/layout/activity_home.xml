<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/player_bg"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/browse_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/gutter"
        android:paddingBottom="@dimen/gutter">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rail"
            android:layout_width="@dimen/rail_width"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/gutter"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/list_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/gutter"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pane_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gutter_half"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/gutter"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/hint_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter_half"
                android:text="@string/hint_browse"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/epg_pane"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/epg_panel_bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/epg_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/epg_prev_time"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/epg_prev_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/text_shadow"
                android:shadowRadius="6"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/epg_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/epg_now_time"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/epg_now_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/text_shadow"
                android:shadowRadius="8"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/epg_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="64dp"
            android:layout_marginTop="6dp"
            android:background="@color/epg_track">

            <View
                android:id="@+id/epg_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/accent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/epg_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/epg_next_time"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/epg_next_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/text_shadow"
                android:shadowRadius="6"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/full_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_top_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="56dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/full_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="@color/text_shadow"
            android:shadowRadius="8"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="@color/text_shadow"
            android:shadowRadius="8"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/full_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/gutter"
        android:background="@drawable/toast_bg"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/hint_fullscreen"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/gutter"
        android:background="@drawable/toast_bg"
        android:maxWidth="520dp"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
